function set_p_apf(idx, mix, freq, order, q, stages, fb_ff, polarity) local(p, w0, alpha, a0, tan_w) (
    p = M_P + idx * NODE_STRIDE;
    freq = max(20.0, min(freq, SAFE_SR_LIMIT)); 
    p[15] = max(1, min(32, floor(stages))); 
    p[21] = order > 1.5 ? 1.0 : 0.0; 
    p[21] != 0.0 ? (
        w0 = TWO_PI * freq * SR_INV;
        alpha = sin(w0) / (2.0 * max(0.1, q));
        a0 = 1.0 + alpha;
        p[13] = -2.0 * cos(w0) / a0; 
        p[14] = (1.0 - alpha) / a0;  
    ) : (
        tan_w = tan(PI * freq * SR_INV);
        p[13] = (tan_w - 1.0) / (tan_w + 1.0); 
        p[14] = 0.0;
    );
    p[16] = fb_ff > 0.0 ? fb_ff : 0.0;  
    p[17] = fb_ff < 0.0 ? -fb_ff : 0.0; 
    p[18] = mix * (polarity < 0.0 ? -1.0 : 1.0); 
    p[19] = 1.0 - mix;                           
    p[20] = mix != 0.0 ? 1.0 : 0.0;              
);

