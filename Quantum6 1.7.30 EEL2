function update_route_flags(idx) local(p) (
    p = M_P + idx * NODE_STRIDE;
    
    p[43] = (p[58]!=0.0 || p[59]!=0.0 || p[60]!=0.0 || p[61]!=0.0 || p[62]!=0.0 || p[63]!=0.0 || p[64]!=0.0 || p[65]!=0.0 || p[66]!=0.0) ? 1.0 : 0.0; 
    p[39] = (p[80]!=0.0 || p[83]!=0.0 || p[84]!=0.0 || p[85]!=0.0 || p[86]!=0.0) ? 1.0 : 0.0; 
    
    p[40] = (p[80]!=0.0 || p[89]!=0.0 || p[63]!=0.0) ? 1.0 : 0.0; 
    p[41] = (p[82]!=0.0 || p[87]!=0.0 || p[63]!=0.0) ? 1.0 : 0.0; 
    // [修复] 剔除 p[89] (Even)，因为它不需要 v_sq
    p[42] = (p[58]!=0.0 || p[60]!=0.0 || p[61]!=0.0 || p[62]!=0.0 || p[64]!=0.0 || p[65]!=0.0) ? 1.0 : 0.0; 
    
    // [优化] 全局形状/动态旁通旗标，用于跳过基础乘法与绝对值
    p[103] = (p[39]!=0.0 || p[40]!=0.0 || p[41]!=0.0 || p[42]!=0.0 || p[43]!=0.0 || p[44]!=0.0 || p[81]!=0.0 || p[88]!=0.0) ? 1.0 : 0.0;
);

