// ==========================================================================
// [SECTION 4] Atomic Core Processing Engine
// ==========================================================================
function process_engine_atomic(p_offset, in, st, sat_st, apf_st)
local(p, type, v1, v2, out_sum, tone_high, v1_norm, ax, tmp_x,
s_i, sat_final, warp_y, tmp_diff,
st0, st1, st2, sat_st0, sat_st1, sat_st2, sat_st3, sat_st9, sat_st10, sat_st11, sat_st12, 
t_st13, tmp_dry, st3, st4, v_sq, apf_in, apf_x, apf_y, apf_out, stg, a1, a2, 
v_soft_10, v_soft_02, k, bq_d, st5, st6) 
(
    p = M_P + p_offset;
    type = p[4];

    in += DENORM_NOISE;

    st0 = st[0]; st1 = st[1];
    
    v1 = st0 * p[91] + p[0] * (in - st1); 
    st[0] = 2.0 * v1 - st0; 
    st[1] = st1 + p[92] * v1;
    p[94] != 0.0 ? v2 = st1 + p[3] * v1 : 0.0;

    out_sum = 0.0;

    // [优化] 极速跳过：当无任何形状处理被激活时，避免计算 v1_norm 和 ax
    p[103] != 0.0 ? (
        v1_norm = v1 * SAFE_B; 
        ax = abs(v1_norm);
        
        p[40] != 0.0 ? v_soft_10 = v1_norm / (1.0 + ax) : 0.0;
        p[41] != 0.0 ? v_soft_02 = v1_norm / (1.0 + ax * 0.2) : 0.0;
        p[42] != 0.0 ? v_sq = v1_norm * v1_norm : 0.0;
    );

    p[81] != 0.0 ? out_sum += (v1_norm / (1.0 + ax * 0.5)) * p[81] : 0.0;
    
    st2 = st[2];
    st[2] = v1;
    
    // [注意] p[88] 依赖原信号 v1，不受 p[103] 中 v1_norm 阻断的影响
    p[88] != 0.0 ? (
        tmp_diff = (v1 - st2) * p[9];
        out_sum += (tmp_diff / (1.0 + abs(tmp_diff) * 0.5)) * p[88];
    ) : 0.0;

    p[39] != 0.0 ? (
        p[80] != 0.0 ? out_sum += v_soft_10 * p[80] : 0;
        p[83] != 0.0 ? out_sum += (v1_norm / (0.05 + ax)) * p[83] : 0;
        p[84] != 0.0 ? out_sum += sin(v1_norm * HALF_PI) * p[84] : 0;
        p[85] != 0.0 ? out_sum += (v1_norm * exp(-ax * 0.6)) * p[85] : 0;
        p[86] != 0.0 ? out_sum += sin(v1_norm * PI) * p[86] : 0;
    );

    p[44] != 0.0 ? (
        p[93] != 0.0 ? (
            s_i = p[46] != 0.0 ? (
                sat_st9 = sat_st[9]; 
                sat_st[9] = (sat_st9 += (sat_st[5] - sat_st9) * p[47]);
                v1_norm + max(-2.0, min(2.0, sat_st9)) * p[46]; 
            ) : v1_norm;

            p[48] != 0.0 ? s_i *= (1.0 + abs(s_i) * p[48]) : 0;
            p[49] < 99.0 ? s_i -= p[49] * floor(s_i * p[52] + 0.5) : 0;

            sat_final = p[90] != 0.0 ? s_i * p[50] : s_i;

            p[51] != 0.0 ? (
                tone_high = sat_final * p[51];
                sat_final += (tone_high - floor(tone_high)) * 0.45;
            ) : 0;

            p[46] != 0.0 ? sat_st[5] = sat_final : 0; 

            p[53] != 0.0 ? (
                sat_st10 = sat_st[10]; sat_st11 = sat_st[11];
                warp_y = p[54] * (sat_final - sat_st11) + sat_st10;
                sat_st[10] = sat_final; sat_st[11] = warp_y;
                sat_final += (warp_y - sat_final) * p[53];
            ) : 0;

            p[56] != 0.0 ? (
                sat_st12 = sat_st[12];
                sat_st[12] = (sat_st12 += (sat_final + sat_st12 * p[57] - sat_st12) * p[55]);
                sat_final += (sat_st12 - sat_final) * p[56];
            ) : 0;
        ) : sat_final = v1_norm;

        p[6] != 0.0 ? (
            sat_st1 = sat_st[1]; 
            sat_st[1] = ax; 
            sat_st2 = sat_st[2];
            sat_st[2] = (sat_st2 += (abs(ax - sat_st1) - sat_st2) * 0.1);
            sat_final /= (1.0 + sat_st2 * p[6]);
        );

        sat_st3 = sat_st[3];
        sat_st[3] = (sat_st3 += (sat_final - sat_st3) * 0.005);
        sat_final -= sat_st3;

        sat_st[0] = (sat_st0 = sat_st[0] + (sat_final - sat_st[0]) * p[45]);
        out_sum += sat_st0 * p[44]; 
    );

    p[82] != 0.0 ? out_sum += v_soft_02 * p[82] : 0.0;

    p[89] != 0.0 ? (
        tmp_dry = v_soft_10 * v1_norm; 
        st3 = st[3];
        st[3] = (st3 += (tmp_dry - st3) * 0.005); 
        out_sum += (tmp_dry - st3) * p[89];
    ) : 0.0;

    p[87] != 0.0 ? (
        tmp_dry = v_soft_02;   
        t_st13 = sat_st[13];
        sat_st[13] = (t_st13 += (tmp_dry - t_st13) * p[36]);
        out_sum += (tmp_dry - t_st13) * p[87]; 
    ) : 0.0;

    p[43] != 0.0 ? (
        (p[58] != 0.0 || p[65] != 0.0) ? (
            tmp_x = (v1_norm * v_sq) / (1.0 + ax * v_sq);
            out_sum += tmp_x * (p[58] + p[65]); 
        ) : 0.0;
        
        p[59] != 0.0 ? out_sum += (v1_norm / (0.1 + ax)) * p[59] : 0;
        
        (p[60] != 0.0 || p[61] != 0.0) ? (
            tmp_x = 1.0 / (1.0 + v_sq);
            p[60] != 0.0 ? out_sum += v1_norm * tmp_x * p[60] : 0.0;
            p[61] != 0.0 ? (
                tmp_dry = v_sq * tmp_x;
                st4 = st[4];
                st[4] = (st4 += (tmp_dry - st4) * 0.01);
                out_sum += (tmp_dry - st4) * p[61];
            ) : 0.0;
        ) : 0.0;

        p[62] != 0.0 ? out_sum += (v1_norm * ax / (1.0 + v_sq * 0.2)) * p[62] : 0;
        p[63] != 0.0 ? out_sum += (v_soft_10 - v_soft_02) * p[63] : 0;
        p[64] != 0.0 ? out_sum -= (v1_norm * 0.4 * v_sq / ((1.0 + 0.5 * v_sq) * (1.0 + 0.1 * v_sq))) * p[64] : 0;
        p[66] != 0.0 ? out_sum += sin(v1_norm * PI) * p[66] : 0;
    );

    p[20] != 0.0 ? (
        apf_in = out_sum + apf_st[64] * p[16]; 
        apf_x = apf_in;
        stg = p[15];
        a1 = p[13];
        
        p[21] != 0.0 ? (
            a2 = p[14];
            stg == 1 ? (
                apf_y = a2 * apf_x + apf_st[0];
                apf_st[0] = a1 * (apf_x - apf_y) + apf_st[1];
                apf_st[1] = apf_x - a2 * apf_y;
                apf_x = apf_y;
            ) : (
                k = 0;
                loop(stg,
                    apf_y = a2 * apf_x + apf_st[k];
                    apf_st[k] = a1 * (apf_x - apf_y) + apf_st[k+1];
                    apf_st[k+1] = apf_x - a2 * apf_y;
                    apf_x = apf_y;
                    k += 2;
                );
            );
        ) : (
            stg == 1 ? (
                apf_y = a1 * apf_x + apf_st[0];
                apf_st[0] = apf_x - a1 * apf_y;
                apf_x = apf_y;
            ) : (
                k = 0;
                loop(stg,
                    apf_y = a1 * apf_x + apf_st[k];
                    apf_st[k] = apf_x - a1 * apf_y;
                    apf_x = apf_y;
                    k += 1;
                );
            );
        );
        
        apf_st[64] = apf_y; 
        apf_out = apf_y + apf_in * p[17]; 
        out_sum = out_sum * p[19] + apf_out * p[18]; 
    );

    p[5] != 0.0 ? (
        type < 2.5 ? (
            out_sum += (type < 0.5 ? v2 : (type < 1.5 ? in - p[2] * v1 - v2 : v1 * p[2])) * p[5];
        ) : (
            st5 = st[5]; st6 = st[6];
            bq_d = p[95] * in + st5;
            p[100] != 0.0 ? (
                st[5] = -p[98] * bq_d + st6;
            ) : (
                st[5] = p[96] * in - p[98] * bq_d + st6;
            );
            st[6] = p[97] * in - p[99] * bq_d;
            out_sum += bq_d * SAFE_B; 
        );
    ) : 0.0;
    
    out_sum - DENORM_NOISE;
);

// ==========================================================================
//[SECTION 5] Runtime Processing
// ==========================================================================
@sample
m_o = (spl0 + spl1) * M_HALF_IG;
s_o = (spl0 - spl1) * M_HALF_IG;
sum_m_effects = 0.0;
sum_s_effects = 0.0;

m_work = m_o * SAFE_A;
s_work = s_o * SAFE_A;

i = 1;
loop(4,
    i_stride = i * NODE_STRIDE;
    p = M_P + i_stride;

    (p[7] != 0.0 || p[8] != 0.0) ? (
        node_sat = M_SAT + i_stride;
        node_apf = M_APF + i_stride;
        p[7] != 0.0 ? sum_m_effects += process_engine_atomic(i_stride, m_work, M_S_MID + i_stride, node_sat,        node_apf       ) * p[7];
        p[8] != 0.0 ? sum_s_effects += process_engine_atomic(i_stride, s_work, M_S_SIDE + i_stride, node_sat + 1000, node_apf + 1000) * p[8];
    );

    i += 1;
);

FLAG_WIDTH != 0.0 ? sum_s_effects *= WIDTH_MUL;

mid_raw = m_o + sum_m_effects;
side_raw = s_o + sum_s_effects;

FLAG_PHASE != 0.0 ? (
    ap_m_out = PHASE_COEFF * mid_raw + M_AP[0];
    M_AP[0] = mid_raw - PHASE_COEFF * ap_m_out + DENORM_NOISE;
    
    ap_s_out = PHASE_COEFF * side_raw + M_AP[1];
    M_AP[1] = side_raw - PHASE_COEFF * ap_s_out + DENORM_NOISE;
    
    FLAG_GAIN != 0.0 ? (
        spl0 = (ap_m_out + ap_s_out) * O_G;
        spl1 = (ap_m_out - ap_s_out) * O_G;
    ) : (
        spl0 = ap_m_out + ap_s_out;
        spl1 = ap_m_out - ap_s_out;
    );
) : (
    FLAG_GAIN != 0.0 ? (
        spl0 = (mid_raw + side_raw) * O_G;
        spl1 = (mid_raw - side_raw) * O_G;
    ) : (
        spl0 = mid_raw + side_raw;
        spl1 = mid_raw - side_raw;
    );
);
