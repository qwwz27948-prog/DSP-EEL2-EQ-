// 1. EQ 模块区 (p[0]-p[6], Biquad: p[95]-p[100])
function set_p_eq(idx, type, f, g, q) local(p, g_tpt, k_damp, inv_denom, A, w0, cw, sw, sA, alpha, a0, b0, b1, b2, a1, a2) (
    p = M_P + idx * NODE_STRIDE;
    f = max(20.0, min(f, SAFE_SR_LIMIT)); 
    q = max(0.1, q); 
    g_tpt = tan(PI * f * SR_INV); 
    k_damp = 1.0 / q; 
    inv_denom = 1.0 / (1.0 + g_tpt * (g_tpt + k_damp));
    p[0] = g_tpt * inv_denom; p[1] = g_tpt + k_damp; p[2] = k_damp; p[3] = g_tpt; 
    p[4] = type; 
    p[6] = CONST_DAMPING * 0.5; 
    p[91] = 1.0 - p[0] * p[1]; 
    p[92] = 2.0 * p[3];        

    type < 2.5 ? (
        p[5] = (exp(g * LN10_DIV_20) - 1.0) * SAFE_B; 
    ) : (
        p[5] = g != 0.0 ? 1.0 : 0.0;
        A  = exp(g * LN10_DIV_20 * 0.5);
        w0 = TWO_PI * f * SR_INV;
        cw = cos(w0); sw = sin(w0);
        
        type == 5 ? ( 
            alpha = sw / (2.0 * q);
            a0 = 1.0 + alpha / A;
            b0 = (1.0 + alpha * A) / a0;
            b1 = (-2.0 * cw) / a0;
            b2 = (1.0 - alpha * A) / a0;
            a1 = b1;
            a2 = (1.0 - alpha / A) / a0;
            p[100] = 1.0; 
        ) : type == 3 ? ( 
            sA = sqrt(A);
            alpha = (sw * 0.5) * sqrt(max(0.0, (A + 1.0/A)*(1.0/q - 1.0) + 2.0));
            a0 = (A + 1.0) + (A - 1.0)*cw + 2.0*sA*alpha;
            b0 = A*((A + 1.0) - (A - 1.0)*cw + 2.0*sA*alpha) / a0;
            b1 = 2.0*A*((A - 1.0) - (A + 1.0)*cw) / a0;
            b2 = A*((A + 1.0) - (A - 1.0)*cw - 2.0*sA*alpha) / a0;
            a1 = -2.0*((A - 1.0) + (A + 1.0)*cw) / a0;
            a2 = ((A + 1.0) + (A - 1.0)*cw - 2.0*sA*alpha) / a0;
            p[100] = 0.0;
        ) : ( 
            sA = sqrt(A);
            alpha = (sw * 0.5) * sqrt(max(0.0, (A + 1.0/A)*(1.0/q - 1.0) + 2.0));
            a0 = (A + 1.0) - (A - 1.0)*cw + 2.0*sA*alpha;
            b0 = A*((A + 1.0) + (A - 1.0)*cw + 2.0*sA*alpha) / a0;
            b1 = -2.0*A*((A - 1.0) + (A + 1.0)*cw) / a0;
            b2 = A*((A + 1.0) + (A - 1.0)*cw - 2.0*sA*alpha) / a0;
            a1 = 2.0*((A - 1.0) - (A + 1.0)*cw) / a0;
            a2 = ((A + 1.0) - (A - 1.0)*cw - 2.0*sA*alpha) / a0;
            p[100] = 0.0;
        );

        p[95] = b0 - 1.0;
        p[96] = b1 - a1;
        p[97] = b2 - a2;
        p[98] = a1;
        p[99] = a2;
    );
    p[94] = (p[5] != 0.0 && type < 1.5) ? 1.0 : 0.0; 
);

